{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "database": {
      "type": "object",
      "properties": { "type": { "enum": ["postgres", "sqlite"] } }
    },
    "migrations": {
      "type": "object",
      "properties": { "mode": { "enum": ["auto", "job", "startup", "disabled"] } }
    },
    "attachments": {
      "type": "object",
      "properties": { "backend": { "enum": ["", "database", "filesystem", "ephemeral"] } }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  }
}
