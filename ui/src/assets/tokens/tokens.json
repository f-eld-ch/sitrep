{
  "$schema": "https://www.designtokens.org/tr/drafts/format/",
  "$description": "sitrep design tokens - logo, colour and type foundations",
  "$extensions": {
    "ch.sitrep.meta": {
      "name": "sitrep",
      "version": "1.0.0",
      "license": "AGPL-3.0",
      "steward": "Verein F-ELD"
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "dodgerBlue": {
        "$value": "#2077CC",
        "$description": "Primary brand and interactive colour"
      },
      "alertRed": {
        "$value": "#FF3B30",
        "$description": "Alert Red. Fixed. Never re-toned."
      },
      "ink": {
        "$value": "#111111",
        "$description": "Base dark surface and body text"
      },
      "paper": {
        "$value": "#FFFFFF",
        "$description": "Base light surface"
      }
    },
    "interaction": {
      "default": {
        "$value": "{color.brand.dodgerBlue}"
      },
      "hover": {
        "$value": "#3E93E0",
        "$description": "Lifts up"
      },
      "pressed": {
        "$value": "#12508F",
        "$description": "Drops down"
      }
    },
    "neutral": {
      "surface": {
        "$value": "#F5F5F5"
      },
      "border": {
        "$value": "#E1E1E1"
      },
      "disabled": {
        "$value": "#A4A4A4"
      },
      "muted": {
        "$value": "#555555",
        "$description": "Muted text on light. Lowest tone that clears 4.5:1 on paper."
      },
      "darkElevated": {
        "$value": "#242424",
        "$description": "Elevated surface on ink"
      },
      "darkBorder": {
        "$value": "#3A3A3A",
        "$description": "Divider on ink"
      }
    },
    "semantic": {
      "info": {
        "$value": "{color.brand.dodgerBlue}"
      },
      "success": {
        "$value": "#006B30",
        "$description": "Dark green. Separated from error by luminance, not hue."
      },
      "warning": {
        "$value": "#E3AE28"
      },
      "error": {
        "$value": "{color.brand.alertRed}"
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["B612", "sans-serif"],
        "$description": "Designed for cockpit displays"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["B612 Mono", "monospace"],
        "$description": "Timestamps, IDs, message data"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "h1": {
        "$value": "44px"
      },
      "h2": {
        "$value": "30px"
      },
      "h3": {
        "$value": "20px"
      },
      "body": {
        "$value": "16px"
      },
      "small": {
        "$value": "14px"
      },
      "mono": {
        "$value": "15px"
      },
      "min": {
        "$value": "11px",
        "$description": "Absolute floor, badges only"
      }
    }
  },
  "logo": {
    "clearspace": {
      "$type": "number",
      "$value": 0.333,
      "$description": "Times symbol height, on all four sides"
    },
    "lockupGap": {
      "$type": "number",
      "$value": 0.5,
      "$description": "Times symbol width, between symbol and wordmark"
    },
    "minSymbolHeight": {
      "$type": "dimension",
      "$value": "24px"
    },
    "minLockupHeight": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Below this, drop the wordmark"
    }
  },
  "surface": {
    "$type": "color",
    "$description": "Semantic roles. Dark is a first-class surface, not an inversion filter.",
    "light": {
      "bg": {
        "$value": "{color.brand.paper}"
      },
      "bgSubtle": {
        "$value": "{color.neutral.surface}"
      },
      "bgElevated": {
        "$value": "{color.brand.paper}"
      },
      "fg": {
        "$value": "{color.brand.ink}"
      },
      "fgMuted": {
        "$value": "{color.neutral.muted}"
      },
      "line": {
        "$value": "{color.neutral.border}"
      }
    },
    "dark": {
      "bg": {
        "$value": "{color.brand.ink}"
      },
      "bgSubtle": {
        "$value": "{color.brand.ink}"
      },
      "bgElevated": {
        "$value": "{color.neutral.darkElevated}"
      },
      "fg": {
        "$value": "{color.brand.paper}"
      },
      "fgMuted": {
        "$value": "{color.neutral.disabled}",
        "$description": "Lowest legible neutral on ink - never the muted step"
      },
      "line": {
        "$value": "{color.neutral.darkBorder}"
      }
    }
  },
  "a11y": {
    "minContrastText": {
      "$type": "number",
      "$value": 4.5
    },
    "minContrastHeadline": {
      "$type": "number",
      "$value": 3
    },
    "minTouchTarget": {
      "$type": "dimension",
      "$value": "44px"
    }
  }
}
